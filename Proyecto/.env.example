# =====================================================================================
#  ComplianceIA · configuración ÚNICA del proyecto
#
#  Copiar a Proyecto/.env (junto al docker-compose.yml) y completar lo marcado con (*):
#      copy .env.example .env        (PowerShell / cmd)      cp .env.example .env
#
#  Lo leen todos:
#    - docker compose: los ${...} del docker-compose.yml y env_file de api/worker/migrate
#    - el backend fuera de Docker (pytest, uvicorn, alembic): app/core/config.py
#    - el frontend con `npm run dev`: next.config.mjs (solo sus 5 variables)
#  El .env NO se sube al repositorio (lleva claves). Si un valor tiene "$", escríbelo "$$".
# =====================================================================================

# ------------------------------------------------------------------ Docker: puertos del host
# Cámbialos si Windows (Hyper-V/WSL) tiene el puerto reservado o ya está en uso.
# WEB_PORT=3000
# API_PORT=8000
# DB_PORT=5433
# REDIS_PORT=6379

# ------------------------------------------------------------------ Docker: PostgreSQL
# Si los cambias, ajusta también DATABASE_URL / DATABASE_URL_SYNC de abajo.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=1234
# POSTGRES_DB=complaince_db

# ------------------------------------------------------------------ Backend: conexiones
# Valores para correr el backend FUERA de Docker (contra el db/redis del compose).
# Dentro de Docker se ignoran: el compose los reemplaza por los servicios internos.
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5433/complaince_db
DATABASE_URL_SYNC=postgresql://postgres:1234@localhost:5433/complaince_db
REDIS_URL=redis://localhost:6379
STORAGE_DIR=./storage

# ------------------------------------------------------------------ Backend: entorno
# development | test | production  (production exige las claves y prohíbe los modos de depuración)
APP_ENV=development

# ------------------------------------------------------------------ Backend: LLM (Groq)
# (*) https://console.groq.com/keys
GROQ_API_KEY=tu_clave_aqui
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
UMBRAL_CONFIANZA=0.8
LLM_TIMEOUT_S=60
LLM_MAX_REINTENTOS=2
LLM_MAX_TOKENS_SALIDA=4096
MAX_CHARS_EVIDENCIA_LLM=8000
MAX_CHARS_JUSTIFICACION_LLM=4000
# USD por millón de tokens del modelo (ver página de precios del proveedor)
LLM_PRECIO_ENTRADA_USD_1M=0
LLM_PRECIO_SALIDA_USD_1M=0

# ------------------------------------------------------------------ Backend: seguridad y anonimización
# true = anonimiza con el motor NER antes del LLM. false SOLO para depurar (prohibido en production).
SANITIZER_ENABLED=true
# bloquear | marcar  (qué hacer con una evidencia que parece prompt injection)
MODO_SEGURIDAD_EVIDENCIA=bloquear
# (*) Clave maestra Fernet: huellas del mapa de entidades, cifrado de evidencias en disco y
# de los textos ARCOP (HU-06). No la cambies sin recifrar los datos. Generar:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENTITY_MAP_KEY=
# HU-06: false = anonimización irreversible (decisión del PO). true reactiva el mapa
# reversible (T-06: prohibido en production).
# GUARDAR_MAPA_ENTIDADES_CIFRADO=false

# ------------------------------------------------------------------ Backend: autenticación
# (*) Firma de los tokens (mín. 32 caracteres en production). Generar:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
AUTH_TOKEN_TTL_MIN=480
# HU-20: evaluaciones, respuestas, evidencias y reportes exigen token (true por defecto).
# false SOLO en desarrollo: abre sin token las evaluaciones por invitación (prohibido en production).
# EXIGIR_TOKEN_EVALUACIONES=true

# ------------------------------------------------------------------ Backend: cuestionario (HU-02)
# Mínimo de caracteres de la justificación en parcialmente_cumplido / requiere_revision
JUSTIFICACION_MIN_CARACTERES=20

# ------------------------------------------------------------------ Encuesta pública (HU-19)
# Versión vigente del aviso legal (debe coincidir con frontend-next/lib/avisoLegal.ts)
AVISO_LEGAL_VERSION=2026-10-v1
# Cloudflare Turnstile: la clave SECRETA la usa el backend y la PÚBLICA el frontend.
# Vacías fuera de production = se omite / se usa la clave de prueba de Cloudflare.
# Secreto de prueba que siempre aprueba: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# Secreto compartido backend <-> BFF de Next (el mismo valor lo usan los dos). Obligatorio
# en production (mín. 32). Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
BFF_SHARED_SECRET=
# Límites contra abuso (solo encuesta pública). Defectos:
# ENCUESTA_INTENTOS_IP_10MIN=10
# ENCUESTA_EVALUACIONES_IP_DIA=10
# ENCUESTA_MAX_EVIDENCIAS_EVALUACION=30
# ENCUESTA_MAX_EVIDENCIAS_IP_DIA=100
# Cuota diaria de validaciones con IA (0 = sin límite), se reinicia a medianoche local
# LLM_CUOTA_DIARIA_EVALUACION=40
# LLM_CUOTA_DIARIA_GLOBAL=2000
# ZONA_HORARIA_CUOTAS=America/Santiago

# ------------------------------------------------------------------ Comparativa y plan formativo (HU-12/HU-13)
# Valores por defecto en app/core/config.py; descomentar solo para cambiarlos.
# META_CUMPLIMIENTO_PUNTAJE=75
# COMPARATIVA_MIN_MUESTRAS=3

# ------------------------------------------------------------------ Informe por correo (HU-12)
# archivo (desarrollo: se guarda en STORAGE_DIR/correos) | smtp | desactivado
# CORREO_MODO=archivo
# CORREO_MODO=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USUARIO=tucuenta@gmail.com
# SMTP_PASSWORD=contrasena_de_aplicacion
# CORREO_REMITENTE=ComplianceIA <tucuenta@gmail.com>

# ------------------------------------------------------------------ Derechos ARCOP (Ley 21.719)
# Por defecto: 30 días corridos, prórroga de 30 y bloqueo en 2 días hábiles.
# Solo descomentar para cambiarlos (nunca dejar el "=" vacío).
# ARCOP_PLAZO_RESPUESTA_DIAS=30
# ARCOP_PLAZO_PRORROGA_DIAS=30
# ARCOP_PLAZO_BLOQUEO_DIAS_HABILES=2
# ARCOP_PLAZO_INFORMACION_DIAS=10

# ------------------------------------------------------------------ T-06: plazos de conservación
# Sin definir = la regla no se aplica. Al vencer, el worker anonimiza (cron diario 03:00 UTC).
# Valores PROPUESTOS en Extras/Cambios/backend/CAMBIOS_T06.md, pendientes del PO.
# RETENCION_DATOS_TITULAR_DIAS=365
# RETENCION_ARCOP_CERRADAS_DIAS=730
# RETENCION_EVENTOS_SEGURIDAD_DIAS=180

# ------------------------------------------------------------------ HU-27: empresa cliente y usuario definitivo
# Página del frontend que recibe el enlace de activación (el token va en #token=...).
# En production debe ser https://
# ACTIVACION_URL_BASE=http://localhost:3000/activar
# Horas de validez del enlace (un solo uso)
# ACTIVACION_TTL_HORAS=72
# Largo mínimo de la contraseña del cliente (mínimo permitido 10)
# CLIENTE_PASSWORD_MIN=12
# Versión del texto de autorización de traspaso (súbela si el PO cambia el texto)
# CONSENTIMIENTO_CONTRATACION_VERSION=2026-10-v2

# ------------------------------------------------ HU-28: inicio/cierre de sesión y recuperación
# Intentos FALLIDOS de inicio de sesión (admin y cliente) antes de bloquear por la ventana (429)
# LOGIN_MAX_FALLOS_CUENTA=5
# LOGIN_MAX_FALLOS_IP=20
# LOGIN_VENTANA_FALLOS_MIN=15
# Página que recibe el enlace de recuperación (el token va en #token=...). Con SMTP en
# production debe ser https://
# RECUPERACION_URL_BASE=http://localhost:3000/restablecer
# Minutos de validez del enlace (un solo uso)
# RECUPERACION_TTL_MIN=30
# Correos de recuperación por cuenta y hora, y solicitudes por IP y hora
# RECUPERACION_CORREOS_CUENTA_HORA=3
# RECUPERACION_SOLICITUDES_IP_HORA=10

# --- HU-26: recorrido de módulos formativos (usuario definitivo) ---
# Nota mínima (0-100) para aprobar la actividad de verificación y completar el módulo
# FORMACION_UMBRAL_APROBACION=70
# Intentos de la actividad por empresa, módulo y día
# FORMACION_INTENTOS_DIA=5

# --- HU-17: evidencias (cuestionario y remediación) ---
# Tamaño máximo de una evidencia (solo PDF, DOCX y TXT, comprobados por su contenido)
# EVIDENCIA_MAX_MB=10
# Evidencias de remediación por empresa y día (cada una usa una llamada al LLM)
# REMEDIACION_EVIDENCIAS_DIA=20
# Caracteres legibles mínimos para enviar una evidencia de remediación al LLM
# EVIDENCIA_MIN_CARACTERES=40

# --- HU-30: vigencia del contrato ---
# Días que el cliente puede descargar sus documentos tras vencer o terminar el contrato
# (0 = sin plazo de gracia; máximo 365). Valor provisorio hasta que lo fije el PO.
# CONTRATO_GRACIA_DIAS=30

# --- HU-15: Agente IA Tutor del panel de formación (usuario definitivo, contrato vigente) ---
# Mensajes al tutor por empresa y día (cada uno es una llamada al LLM; 0 = sin límite).
# Decisión del PO (28-oct): 60. Se reinicia a medianoche de ZONA_HORARIA_CUOTAS.
# TUTOR_MENSAJES_DIA_EMPRESA=60
# Ráfaga: mensajes por empresa en 60 segundos (0 = sin límite)
# TUTOR_MENSAJES_MINUTO_EMPRESA=6
# Largo máximo del mensaje del usuario (caracteres)
# TUTOR_MAX_CHARS_MENSAJE=2000
# Mensajes previos (ya anonimizados) que se envían como historial al LLM (0-30)
# TUTOR_HISTORIAL_MENSAJES=6
# Brechas que entran al prompt, por prioridad
# TUTOR_MAX_BRECHAS_CONTEXTO=40
# Conversaciones guardadas por empresa
# TUTOR_MAX_CONVERSACIONES=50
# Modelo del tutor (vacío = LLM_MODEL), tokens de salida, tiempo máximo y temperatura (0-1)
# TUTOR_MODELO=openai/gpt-oss-20b
# TUTOR_MAX_TOKENS_SALIDA=4096
# TUTOR_TIMEOUT_S=45
# TUTOR_TEMPERATURA=0.3
# Días sin actividad tras los que se BORRA una conversación (decisión del PO: 30).
# También se borran con la supresión ARCOP del usuario definitivo.
# TUTOR_RETENCION_DIAS=30

# --- HU-18: gobernanza del Agente IA ---
# Mensajes bloqueados por el filtro (de la misma empresa) dentro de la ventana a partir de
# los cuales el tutor muestra una ADVERTENCIA por mal uso. Decisión del PO (28-oct): 3.
# La advertencia no bloquea: los mensajes legítimos siguen funcionando.
# TUTOR_BLOQUEOS_ADVERTENCIA=3
# Ventana de esa cuenta, en minutos (1-1440)
# TUTOR_VENTANA_BLOQUEOS_MIN=10
# Clave del HMAC que encadena la bitácora de auditoría. Vacía = se deriva de AUTH_SECRET.
# Si se define, no cambiarla después: las filas ya encadenadas dejarían de verificar.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# BITACORA_CLAVE_HASH=

# ------------------------------------------------------------------ HU-31: "Contratar la plataforma"
# Versión del texto del consentimiento de CONTACTO COMERCIAL (separado del de traspaso)
# CONSENTIMIENTO_CONTACTO_VERSION=2026-10-v1
# Correo del equipo comercial que recibe el aviso de cada solicitud nueva (vacío = sin aviso).
# El aviso no lleva nombre, correo ni teléfono de la persona: solo el número y el enlace.
# CONTRATACION_AVISO_EMAIL=comercial@therionlabs.cl
# Bandeja del administrador que se enlaza en el aviso
# CONTRATACION_BANDEJA_URL=http://localhost:3000/admin/clientes
# Solicitudes por IP y día (sin definir = el mismo valor que ENCUESTA_EVALUACIONES_IP_DIA).
# Déjala comentada si no la cambias: una línea vacía "CONTRATACION_SOLICITUDES_IP_DIA=" no es válida.
# CONTRATACION_SOLICITUDES_IP_DIA=10

# ------------------------------------------------------------------ Frontend (Next.js)
# Solo para `npm run dev` fuera de Docker (en Docker los fija el compose).
# URL del backend: http://localhost:<API_PORT>
API_URL=http://localhost:8000
# 1 = el panel usa datos de demostración y no llama a la API
NEXT_PUBLIC_DEMO=0
# Proxies de confianza delante de Next (0 = acceso directo; 1 = detrás de nginx/balanceador)
TRUSTED_PROXY_HOPS=0
