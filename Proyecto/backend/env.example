# Con docker compose, DATABASE_URL, DATABASE_URL_SYNC, REDIS_URL y STORAGE_DIR se
# ignoran (el compose usa los servicios db y redis). Sirven para correr sin Docker.
DATABASE_URL=postgresql+asyncpg://postgres:1234@127.0.0.1:5433/complaince_db
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:1234@127.0.0.1:5433/complaince_db
REDIS_URL=redis://127.0.0.1:6379
GROQ_API_KEY=tu_clave_aqui
LLM_MODEL=openai/gpt-oss-safeguard-20b
UMBRAL_CONFIANZA=0.8
STORAGE_DIR=./storage
MAX_CHARS_EVIDENCIA_LLM=8000
# bloquear | marcar  (ver app/core/config.py)
MODO_SEGURIDAD_EVIDENCIA=bloquear

# ---------------------------------------------------- Capa de Políticas e IA
# development | test | production  (en production SANITIZER_ENABLED=false no arranca)
APP_ENV=development
LLM_PROVIDER=groq
LLM_TIMEOUT_S=60
LLM_MAX_REINTENTOS=2
LLM_MAX_TOKENS_SALIDA=1500
MAX_CHARS_JUSTIFICACION_LLM=4000
# USD por millón de tokens del modelo (ver página de precios del proveedor)
LLM_PRECIO_ENTRADA_USD_1M=0
LLM_PRECIO_SALIDA_USD_1M=0
# true = anonimiza con el motor NER antes del LLM. false SOLO para depurar.
SANITIZER_ENABLED=true
# Clave Fernet del mapa de entidades. Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENTITY_MAP_KEY=
