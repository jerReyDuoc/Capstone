DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mydb
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/mydb
REDIS_URL=redis://localhost:6379
GROQ_API_KEY=tu_clave_aqui
LLM_MODEL=openai/gpt-oss-20b
UMBRAL_CONFIANZA=0.8
STORAGE_DIR=./storage
MAX_CHARS_EVIDENCIA_LLM=8000
# bloquear | marcar  (ver app/core/config.py)
MODO_SEGURIDAD_EVIDENCIA=bloquear

# ---------------------------------------------------- Capa de Políticas e IA
# development | test | production  (en production SANITIZER_ENABLED=false no arranca)
APP_ENV=development
LLM_PROVIDER=groq
LLM_TIMEOUT_S=60
LLM_MAX_REINTENTOS=2
LLM_MAX_TOKENS_SALIDA=4096
MAX_CHARS_JUSTIFICACION_LLM=4000
# USD por millón de tokens del modelo (ver página de precios del proveedor)
LLM_PRECIO_ENTRADA_USD_1M=0
LLM_PRECIO_SALIDA_USD_1M=0
# true = anonimiza con el motor NER antes del LLM. false SOLO para depurar.
SANITIZER_ENABLED=true
# Clave maestra Fernet (obligatoria): huellas del mapa de entidades, cifrado de las
# evidencias en disco y de los textos ARCOP (HU-06). Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# No la cambies sin recifrar los datos (ver CAMBIOS_HU06.md).
ENTITY_MAP_KEY=
# HU-06: false = anonimización irreversible (decisión del PO). true reactiva el mapa reversible
# (T-06: prohibido con APP_ENV=production).
# GUARDAR_MAPA_ENTIDADES_CIFRADO=false
# ---------------------------------------------------- Autenticación de la API
AUTH_SECRET=
AUTH_TOKEN_TTL_MIN=480

# ---------------------------------------------------- Plazos solicitudes ARCOP
# Por defecto: 30 días corridos, prórroga de 30 y bloqueo en 2 días hábiles (Ley 21.719).
# Solo descomentar para cambiarlos (nunca dejar el "=" vacío).
# ARCOP_PLAZO_RESPUESTA_DIAS=30
# ARCOP_PLAZO_PRORROGA_DIAS=30
# ARCOP_PLAZO_BLOQUEO_DIAS_HABILES=2
# ARCOP_PLAZO_INFORMACION_DIAS=10

# ---------------------------------------------------- T-06: plazos de conservación
# Sin definir = la regla no se aplica. Al vencer, el worker anonimiza (cron diario 03:00 UTC).
# Valores PROPUESTOS en CAMBIOS_T06.md, pendientes de aprobación del PO.
# Solo descomentar para activarlos (nunca dejar el "=" vacío).
# RETENCION_DATOS_TITULAR_DIAS=365
# RETENCION_ARCOP_CERRADAS_DIAS=730
# RETENCION_EVENTOS_SEGURIDAD_DIAS=180

# ------------ Mínimo de caracteres de la justificación en parcialmente_cumplido / requiere_revision
JUSTIFICACION_MIN_CARACTERES=20
# ---------------------------------------------------- HU-19: encuesta pública (landing)
# Versión vigente del aviso legal (debe coincidir con frontend-next/lib/avisoLegal.ts)
AVISO_LEGAL_VERSION=2026-10-v1
# Cloudflare Turnstile. Obligatoria en production. Para desarrollo puedes usar el
# secreto de prueba de Cloudflare que siempre aprueba: 1x0000000000000000000000000000000AA
# (o dejarla vacía: el CAPTCHA se omite con un aviso en el log).
TURNSTILE_SECRET_KEY=
# Secreto compartido con el BFF de Next (mismo valor en el servicio web). Obligatorio en
# production (mín. 32). Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
BFF_SHARED_SECRET=
# Límites contra abuso (solo encuesta pública). Defectos:
# ENCUESTA_INTENTOS_IP_10MIN=10
# ENCUESTA_EVALUACIONES_IP_DIA=10
# ENCUESTA_MAX_EVIDENCIAS_EVALUACION=30
# ENCUESTA_MAX_EVIDENCIAS_IP_DIA=100
# Cuota diaria de validaciones con IA (0 = sin límite), se reinicia a medianoche local
# LLM_CUOTA_DIARIA_EVALUACION=40
# LLM_CUOTA_DIARIA_GLOBAL=2000
# ZONA_HORARIA_CUOTAS=America/Santiago
# HU-20: true = exigir token también en evaluaciones por invitación
# EXIGIR_TOKEN_EVALUACIONES=false
