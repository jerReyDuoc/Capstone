# Backend FastAPI (lo usa el servidor de Next para reenviar /api/*)
API_URL=http://localhost:8000

# 1 = el panel usa datos de demostración y no llama a la API.
# Útil para revisar el diseño sin levantar Docker. En producción: 0.
NEXT_PUBLIC_DEMO=0

# ---------------------------------------------------- HU-19: encuesta pública
# Clave PÚBLICA de Cloudflare Turnstile (la secreta va solo en backend/.env).
# Vacía fuera de producción = clave de prueba de Cloudflare que siempre aprueba.
TURNSTILE_SITE_KEY=
# Mismo valor que BFF_SHARED_SECRET del backend (obligatorio en producción).
BFF_SHARED_SECRET=
# Proxies de confianza delante de Next (0 = acceso directo; 1 = detrás de nginx/balanceador).
TRUSTED_PROXY_HOPS=0
